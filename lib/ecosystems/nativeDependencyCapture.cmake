# Injected from the capture directory, never copied into the scanned source.
# A macro preserves the native find_package caller's variable scope. No request
# arguments or provider search settings are added, removed or reordered.
function(_cdx_native_json_string output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_cdx_native_record name consumer arguments)
  set(found FALSE)
  if(DEFINED ${name}_FOUND)
    set(found "${${name}_FOUND}")
  endif()
  set(config "${${name}_CONFIG}")
  set(version "${${name}_VERSION}")
  if(NOT version)
    set(version "${${name}_VERSION_STRING}")
  endif()
  if(NOT version)
    string(TOUPPER "${name}" upper_name)
    set(version "${${upper_name}_VERSION}")
    if(NOT version)
      set(version "${${upper_name}_VERSION_STRING}")
    endif()
  endif()
  set(row "{}")
  foreach(key name consumer arguments found config version)
    _cdx_native_json_string(quoted "${${key}}")
    string(JSON row SET "${row}" "${key}" "${quoted}")
  endforeach()
  file(APPEND "${CDX_NATIVE_CAPTURE_OUTPUT}" "${row}\n")
endfunction()

macro(find_package)
  _find_package(${ARGV})
  _cdx_native_record("${ARGV0}" "${CMAKE_CURRENT_LIST_FILE}" "${ARGV}")
endmacro()
